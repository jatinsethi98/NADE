# NADE backend tasks. Run from `backend/`.
#
#   just            list the recipes
#   just run        serve on 127.0.0.1:8080 with the embedded dev database
#   just pair       print (or mint) a pairing code
#
# `just` itself: cargo install just

set dotenv-load := true
set positional-arguments := true

export PATH := env_var('HOME') / '.cargo/bin:' + env_var('PATH')

crate := "nade-server"

# List the recipes.
default:
    @just --list --unsorted

# Serve the API. Boots the embedded PostgreSQL if DATABASE_URL is unset.
run *args:
    NADE_ENV=${NADE_ENV:-dev} cargo run -p {{ crate }} -- "$@"

# Compile everything, tests included.
build:
    cargo build -p {{ crate }} --all-targets

# The whole suite. Each test gets its own freshly migrated database.
test *args:
    cargo test -p {{ crate }} -- "$@"

# Create/upgrade the database, then exit.
migrate:
    NADE_ENV=${NADE_ENV:-dev} cargo run -q -p {{ crate }} -- --migrate

# Print the live pairing code, or mint a fresh one if none is live.
# The running server honours a code minted here on its next pairing attempt.
pair:
    @NADE_ENV=${NADE_ENV:-dev} cargo run -q -p {{ crate }} -- --print-pair-code

# The consent click is the one step only a human can do; everything either side
# of it is covered by the wiremock suite.
#
# `/v1/auth/gmail/start` is no longer a URL you can just type: it demands a
# single-use capability minted by `POST /v1/auth/gmail/link`, which is behind
# the bearer guard (backend/DECISIONS.md D15). So this recipe walks the whole
# path a paired device walks - pair, mint, print - against a running server.
# Print the URL to open in a browser to connect Gmail.
gmail-connect:
    #!/usr/bin/env bash
    set -euo pipefail
    base="http://${NADE_BIND:-127.0.0.1}:${NADE_PORT:-8080}"
    if ! curl -fsS "$base/v1/healthz" >/dev/null; then
        echo "No server on $base - start one with \`just run\` first." >&2
        exit 1
    fi
    code="$(NADE_ENV=${NADE_ENV:-dev} cargo run -q -p {{ crate }} -- --print-pair-code \
              | sed -n 's/.*pairing code: *\([0-9]\{6\}\).*/\1/p' | head -1)"
    token="$(curl -fsS -XPOST "$base/v1/auth/pair" \
              -H 'content-type: application/json' \
              -d "{\"code\":\"$code\",\"device_name\":\"just gmail-connect\"}" \
              | grep -oE 'nade_[0-9a-f]{64}')"
    url="$(curl -fsS -XPOST "$base/v1/auth/gmail/link" \
              -H "Authorization: Bearer $token" \
              | grep -oE 'https?://[^"]+')"
    echo
    echo "Open this in a browser - single use, ten minutes, and consent must"
    echo "finish in the same browser that opens it:"
    echo "  $url"
    echo
    echo "It redirects to Google, and the callback binds the account, stores the"
    echo "tokens, and queues the first 30-day sync."

# The parser conformance corpus and the live-mail smoke, with their counts.
parser:
    cargo test -p {{ crate }} mail:: -- --nocapture --test-threads=1

# sqlx records a checksum per migration and refuses a modified one, so an
# already-migrated dev database fails to boot after 0001_init.sql is amended.
# Test databases are created fresh per test and are unaffected.
# Drop and recreate the dev database.
db-reset:
    @.pgcache/*/bin/psql "postgres://postgres:${NADE_PG_PASSWORD:-nade-dev}@127.0.0.1:${NADE_PG_PORT:-54329}/postgres" \
        -c "drop database if exists ${NADE_DB_NAME:-nade}"
    @just migrate

# Stop the shared embedded PostgreSQL (it deliberately outlives `just run`).
db-stop:
    NADE_ENV=${NADE_ENV:-dev} cargo run -q -p {{ crate }} -- --stop-db

# Open a psql on the dev database. Needs the embedded server to be running.
db-shell:
    @.pgcache/*/bin/psql "postgres://postgres:${NADE_PG_PASSWORD:-nade-dev}@127.0.0.1:${NADE_PG_PORT:-54329}/${NADE_DB_NAME:-nade}"

# Scoped to this crate with `-p`, like `build`, `test` and `lint` already are.
# A bare `cargo fmt` is workspace-wide, so a sibling crate mid-edit in another
# lane would both fail our gate and get its working tree reformatted under it.
fmt:
    cargo fmt -p {{ crate }}

fmt-check:
    cargo fmt -p {{ crate }} --check

lint:
    cargo clippy -p {{ crate }} --all-targets -- -D warnings

# Exactly what the acceptance gate runs, P1 and P2 alike.
ci: build lint fmt-check test
