# NADE backend configuration.
#
# Copy to backend/.env (gitignored) and edit. Every variable the server reads is
# listed here; config::tests::env_example_documents_every_var fails if this file
# and the code ever disagree, in either direction.
#
# Everything has a working default, so an empty .env is a valid .env.

# ----------------------------------------------------------------- runtime --

# Log filter, tracing-subscriber syntax. Default: info,sqlx=warn,tower_http=info
RUST_LOG=info,sqlx=warn,tower_http=info

# `dev` (any case) unlocks two things and nothing else: the embedded PostgreSQL,
# and the NADE_TOKEN bearer shortcut below. Anything else - including unset,
# blank, or a typo - is treated as production. Default: prod
NADE_ENV=dev

# Listen address. Default: 127.0.0.1
NADE_BIND=127.0.0.1

# Listen port. Default: 8080
NADE_PORT=8080

# ---------------------------------------------------------------- database --

# When set, used verbatim and the embedded PostgreSQL is never started.
# Required unless NADE_ENV is dev.
# DATABASE_URL=postgres://nade:secret@127.0.0.1:5432/nade

# Database created inside the embedded server when DATABASE_URL is unset.
# Default: nade
NADE_DB_NAME=nade

# Pool size. Default: 10
NADE_DB_MAX_CONNECTIONS=10

# -------------------------------------------------------------------- auth --

# Bearer value accepted as a shortcut instead of a paired device token.
# IGNORED unless NADE_ENV is exactly `dev`. Leave unset in production; leaving
# it set there is harmless but pointless.
# NADE_TOKEN=dev-only-token

# Where the live pairing code is mirrored so `just pair` (a separate process)
# can read or replace it. Mode 0600. Default: <backend>/secrets/pair-code.json,
# and backend/secrets/ is gitignored.
# NADE_PAIR_CODE_FILE=secrets/pair-code.json

# Pairing code lifetime in seconds. PLAN.md says 10 minutes. Default: 600
NADE_PAIR_CODE_TTL_SECS=600

# Pairing attempts allowed per window, process-wide. This is what makes a
# 6-digit code safe. Default: 10
NADE_PAIR_RATE_LIMIT=10

# The window those attempts are counted over, in seconds. Default: 60
NADE_PAIR_RATE_WINDOW_SECS=60

# ------------------------------------------------------------------- gmail --

# Google's downloaded OAuth web client JSON. Absent is survivable: the server
# boots, every non-Gmail route works, and /v1/auth/gmail/start says so.
# Default: <backend>/secrets/web_client.json (gitignored)
# NADE_GMAIL_CLIENT_FILE=secrets/web_client.json

# Must match a redirect URI registered on that Google client.
# Default: http://localhost:8080/v1/auth/gmail/callback
NADE_GMAIL_REDIRECT_URI=http://localhost:8080/v1/auth/gmail/callback

# Override Google's own endpoints. Only the test suite sets these; in production
# they come from the client file above.
# NADE_GMAIL_AUTH_URL=https://accounts.google.com/o/oauth2/auth
# NADE_GMAIL_TOKEN_URL=https://oauth2.googleapis.com/token

# The Gmail REST root. Default: https://gmail.googleapis.com
# NADE_GMAIL_API_BASE=https://gmail.googleapis.com

# AES-256-GCM key for the stored Gmail tokens, 64 hex characters (32 bytes).
# Unset means "use the key file", which is generated with mode 0600 on first
# use. Changing or losing it means the account must re-consent.
# NADE_TOKEN_KEY=

# Where that key lives. Default: <backend>/secrets/token-key (gitignored)
# NADE_TOKEN_KEY_FILE=secrets/token-key

# PLAN.md's MAX_SYNC_MESSAGES. A dev cap, and dev caps are law. Default: 2000
NADE_MAX_SYNC_MESSAGES=2000

# The sync window, in days. PLAN.md fixes it at 30. Default: 30
NADE_SYNC_WINDOW_DAYS=30

# Messages per multipart batch. 45 x 5 quota units = 225, inside Gmail's 250/s
# ceiling. Maximum 45. Default: 45
NADE_SYNC_BATCH_SIZE=45

# -------------------------------------------------------------------- jobs --

# Worker loops to run. Default: 2
NADE_WORKERS=2

# How long a claimed job stays leased before the reaper may take it back.
# Default: 300
NADE_JOB_LEASE_SECS=300

# How often a running handler extends its lease. Must be shorter than the lease
# or the server refuses to start. Default: 60
NADE_JOB_HEARTBEAT_SECS=60

# Failures after which a job is dead-lettered and audited. Default: 5
NADE_JOB_MAX_ATTEMPTS=5

# Idle poll interval in milliseconds. Default: 1000
NADE_JOB_POLL_MS=1000

# How often a worker sweeps expired leases, in seconds. Default: 30
NADE_JOB_REAP_SECS=30

# How long a shutting-down worker waits for its in-flight job before releasing
# the lease for someone else, in seconds. Default: 30
NADE_JOB_SHUTDOWN_GRACE_SECS=30

# ------------------------------------------------ embedded postgres (dev) --

# The directory that owns .pgdata, .pgcache and secrets/. Default: the `backend`
# directory this crate was compiled from.
# NADE_BACKEND_ROOT=/Users/you/Projects/NADE/backend

# Port the embedded cluster listens on. Default: 54329
NADE_PG_PORT=54329

# Superuser password for the embedded cluster. Baked in at first `initdb`;
# changing it afterwards means deleting backend/.pgdata. Default: nade-dev
NADE_PG_PASSWORD=nade-dev

# Cluster data directory. Default: <backend>/.pgdata (gitignored)
# NADE_PG_DATA_DIR=.pgdata

# Downloaded PostgreSQL binaries. Default: <backend>/.pgcache (gitignored)
# NADE_PG_CACHE_DIR=.pgcache
